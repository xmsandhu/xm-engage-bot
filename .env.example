# Frontend build-time variables for Vite
# Copy to .env and fill in values before building/deploying

# If deploying with Netlify/Vercel proxy, you can leave this as /api/chat
VITE_API_URL=/api/chat

# Optional, only for direct calls to API Gateway during local testing
# WARNING: Client-side API keys are visible in the browser dev tools
VITE_API_KEY=
